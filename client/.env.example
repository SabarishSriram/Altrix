# Base URL of the Altrix FastAPI server (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: sync the Investments paper journal across devices with Supabase (client/supabase/schema.sql).
# Project Settings -> API Keys: the Project URL and the publishable key (sb_publishable_...).
# Never put the secret (sb_secret_...) or service_role key here: it would be visible to every visitor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
